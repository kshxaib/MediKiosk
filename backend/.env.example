# ---------------------------------------------------------------------------
# MediKiosk backend environment configuration.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Only the Phase 1 variables below are read by the application today; the
# later-phase entries are documented placeholders (see PROJECT_REQUIREMENT.md
# section 38) and MUST stay empty until their phase is implemented.
# ---------------------------------------------------------------------------

# --- Application (Phase 1) ---
APP_NAME=MediKiosk
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database (Phase 1) ---
# Must match the Postgres service in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://medikiosk:medikiosk@localhost:5432/medikiosk

# --- CORS (Phase 1) ---
# Comma-separated list of allowed browser origins (Vite dev server default).
BACKEND_CORS_ORIGINS=http://localhost:5173

# ===========================================================================
# FUTURE PHASES — placeholders only. Do NOT populate in Phase 1.
# ===========================================================================

# --- Staff auth / JWT (Phase 2) ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- AI / LLM & embeddings (Phase 5) ---
LLM_API_KEY=
EMBEDDING_API_KEY=

# --- Speech (Phase 5) ---
STT_API_KEY=
TTS_API_KEY=

# --- Cloudinary document storage (Phase 6) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Qdrant vector database (Phase 6) ---
QDRANT_URL=
QDRANT_API_KEY=
