# Environment
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://medikiosk:medikiosk@localhost:5432/medikiosk

# CORS (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:5173

# Authentication & JWT
JWT_SECRET_KEY=replace_with_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Biometric Face Recognition (Phase 3)
FACE_MODEL_NAME=buffalo_l
FACE_SIMILARITY_THRESHOLD=0.50
FACE_DETECTION_SIZE=640

# AI / LLM (Phase 5B) — OpenAI via LangChain.
# Backend-only. NEVER expose this key to the frontend.
# Leave OPENAI_API_KEY empty to run the interview on the deterministic
# (non-LLM) engine; the kiosk stays fully functional either way.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_RETRIES=2
