# MediKiosk frontend environment configuration.
# Copy this file to `.env` and adjust values. NEVER commit `.env`.
# Only variables prefixed with VITE_ are exposed to the browser bundle,
# so NO backend secrets may ever be placed here.

# Base URL of the MediKiosk backend API (includes the version prefix).
VITE_API_BASE_URL=http://localhost:8000/api/v1
